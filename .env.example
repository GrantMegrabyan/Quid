# Copy to .env and adjust for your deployment. Read by docker-compose.

# Browser-reachable origin of the API (the ui container exposes it on :8001).
# Must be reachable from the user's browser, not the internal compose network.
PUBLIC_API_BASE_URL=http://localhost:8001

# Production hardening (required, no '*'): trusted Host header values.
QUID_ALLOWED_HOSTS=localhost

# Production hardening (required, no '*'): exact allowed browser origins.
# Must include the ui origin (the ui container exposes it on :3001).
QUID_CORS_ALLOWED_ORIGINS=http://localhost:3001

# Optional: OpenRouter API key for the AI features (import categorisation,
# Amazon order categorisation, Amazon short names). Leave blank to disable.
QUID_OPENROUTER_API_KEY=
