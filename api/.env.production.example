# Quid API — PRODUCTION example environment
#
# Every variable uses the QUID_ prefix.
#
# !! Never commit a file containing a real QUID_OPENROUTER_API_KEY. Inject
# !! secrets via your platform's secret manager, not a checked-in .env.
#
# In production mode the app FAILS FAST on startup (ProductionConfigError) when:
#   - QUID_ALLOWED_HOSTS is missing or contains "*"
#   - QUID_CORS_ALLOWED_ORIGINS is missing or contains "*"
#   - QUID_TESTING is true
# So the marked-REQUIRED variables below must be set to safe values.

# --- Core -------------------------------------------------------------------

# REQUIRED: enables production hardening (fail-fast checks, locked-down CORS,
# TrustedHostMiddleware, docs off unless explicitly enabled).
QUID_ENVIRONMENT=production

# Async SQLAlchemy database URL. Point at your production database file/volume.
QUID_DATABASE_URL=sqlite+aiosqlite:///./.data/quid.db

# Application log level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
QUID_LOG_LEVEL=INFO

# Rotating log file path (set empty to disable file logging).
QUID_LOG_FILE=./.data/quid.log

# MUST be false in production (the app refuses to start otherwise).
QUID_TESTING=false

# --- Network hardening ------------------------------------------------------

# REQUIRED: comma-separated trusted Host header values. Requests with any other
# Host get a 400. Must NOT contain "*". Example for one or more hostnames:
QUID_ALLOWED_HOSTS=api.example.com

# REQUIRED: comma-separated EXACT allowed browser origins. Must NOT contain "*".
# The development regex (QUID_CORS_ORIGIN_REGEX) is ignored in production.
QUID_CORS_ALLOWED_ORIGINS=https://app.example.com
# Multiple origins example:
# QUID_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Expose /docs, /redoc, /openapi.json in production. OFF by default; set true
# only if you intend the API docs to be publicly reachable.
QUID_DOCS_ENABLED=false

# Attach safe static response headers (X-Content-Type-Options: nosniff,
# X-Frame-Options: DENY, Referrer-Policy: no-referrer,
# Cross-Origin-Opener-Policy: same-origin). Keep enabled.
# Note: HSTS is intentionally NOT set here — terminate TLS and set
# Strict-Transport-Security at your reverse proxy.
QUID_SECURITY_HEADERS_ENABLED=true

# --- AI features (OpenRouter) ----------------------------------------------
# Whether the AI features run is controlled by persisted app settings
# (aiCategorizeEnabled / aiShortNamesEnabled), not env vars.

# Required when any AI feature is enabled. Inject via a secret manager.
QUID_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model used for both AI categorisation and Amazon short names.
QUID_OPENROUTER_MODEL=openai/gpt-5.4-mini

# Max items per OpenRouter call; large imports are split into sequential chunks.
QUID_OPENROUTER_CHUNK_SIZE=25

# --- Refund detection -------------------------------------------------------

# Window (days) used to pair a refund with its original charge.
QUID_REFUND_WINDOW_DAYS=60
