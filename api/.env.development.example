# Quid API — DEVELOPMENT example environment
#
# Every variable uses the QUID_ prefix. All values below are the built-in
# defaults unless noted, so in development you can usually leave most of them
# commented out and only set QUID_OPENROUTER_API_KEY.

# --- Core -------------------------------------------------------------------

# Async SQLAlchemy database URL (default below). The dev/default DB lives at
# api/.data/quid.db.
# QUID_DATABASE_URL=sqlite+aiosqlite:///./.data/quid.db

# Application log level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
# QUID_LOG_LEVEL=INFO

# Rotating log file path (set empty to disable file logging).
# QUID_LOG_FILE=./.data/quid.log

# Mounts /api/v1/testing/* helper endpoints when true. Leave false outside
# the e2e harness. MUST be false in production.
# QUID_TESTING=false

# --- AI features (OpenRouter) ----------------------------------------------
# Whether the two AI features actually run is controlled by persisted app
# settings (aiCategorizeEnabled / aiShortNamesEnabled), edited on the web UI
# Settings page — NOT by env vars. The vars below only supply credentials/model.

# Required when any AI feature is enabled. Get a key at https://openrouter.ai.
QUID_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model used for both AI categorisation and Amazon short names.
# QUID_OPENROUTER_MODEL=openai/gpt-5.4-mini

# Max items per OpenRouter call; large imports are split into sequential chunks.
# QUID_OPENROUTER_CHUNK_SIZE=25

# --- Refund detection -------------------------------------------------------

# Window (days) used to pair a refund with its original charge.
# QUID_REFUND_WINDOW_DAYS=60

# --- Production hardening (development values) ------------------------------
# In development (the default) these keep the permissive localhost behaviour:
# CORS allows any http://localhost port, any Host is accepted, and /docs is on.
# You normally do NOT need to set any of these locally.

# Deployment mode: development | production. Leave as development locally.
# QUID_ENVIRONMENT=development

# Allowed browser origins IN DEVELOPMENT (regex). Defaults to any localhost port.
# Ignored in production (use QUID_CORS_ALLOWED_ORIGINS there).
# QUID_CORS_ORIGIN_REGEX=^http://localhost(:\d+)?$

# Comma-separated trusted Host header values (TrustedHostMiddleware). Empty
# means "any host", which is fine for local dev.
# QUID_ALLOWED_HOSTS=

# Comma-separated exact CORS origins — only used in production; ignored in dev.
# QUID_CORS_ALLOWED_ORIGINS=

# Expose /docs, /redoc, /openapi.json. Always ON in development regardless of
# this flag; only matters in production.
# QUID_DOCS_ENABLED=false

# Attach safe response headers (X-Content-Type-Options, X-Frame-Options,
# Referrer-Policy, Cross-Origin-Opener-Policy). On in both modes.
# QUID_SECURITY_HEADERS_ENABLED=true
